# Header untuk fail statik sahaja. Respons Pages Functions set header sendiri (lib/http.js).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://media.annurpro.com; connect-src 'self' https://accounts.google.com/gsi/ https://media.annurpro.com; frame-src https://accounts.google.com/gsi/; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/app/*
  Cache-Control: no-cache

/admin/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex

# Halaman HTML awam: sentiasa semak versi terbaru supaya HTML dan CSS/JS tak bercampur antara deploy.
/
  Cache-Control: no-cache

/privasi
  Cache-Control: no-cache

/terma
  Cache-Control: no-cache

/offline
  Cache-Control: no-cache

# CSS dan JS: tiada hash dalam nama fail, jadi pelayar mesti sentiasa semak semula (304 jika tak berubah).
# HTML juga memautkannya dengan ?v=<versi>; naikkan versi itu bila CSS/JS berubah (tests/static.test.js menyemak).
/assets/css/*
  Cache-Control: no-cache

/assets/js/*
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
